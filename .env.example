PORT=4000
NODE_ENV=development
# Comma-separated list of allowed frontend origins
CLIENT_URLS=https://warangal-startups.vercel.app,https://ws-portel.web.app,http://warangal-startups.vercel.app,http://localhost:3000,http://localhost:5173
FRONTEND_URL=https://warangal-startups.vercel.app

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-secret-key  # server only, never expose

# Where Supabase email links send the user
EMAIL_REDIRECT_URL=https://warangal-startups.vercel.app/#/auth/verified
PASSWORD_RESET_REDIRECT_URL=https://warangal-startups.vercel.app/#/auth/reset-password

# Payments are paused for now.
PAYMENTS_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional if browser-side payment verification is used. Configure and subscribe to captured/paid events for reliable webhook reconciliation.
RAZORPAY_WEBHOOK_SECRET=
