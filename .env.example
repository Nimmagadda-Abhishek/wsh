PORT=4000
NODE_ENV=development
# Comma-separated list of allowed frontend origins
CLIENT_URLS=https://ws-portel.web.app,http://localhost:3000,http://localhost:5173

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-secret-key  # server only, never expose

# Where Supabase email links send the user
EMAIL_REDIRECT_URL=https://ws-portel.web.app/#/auth/verified
PASSWORD_RESET_REDIRECT_URL=https://ws-portel.web.app/#/auth/reset-password

RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=xxx
RAZORPAY_WEBHOOK_SECRET=xxx
